# =====================================================================
# .env.example — copy to .env and fill in. NEVER commit a real .env.
# In production, set these in Vercel → Project → Settings → Environment
# Variables (Production + Preview).
# =====================================================================

# Required: your OpenRouter key (https://openrouter.ai/keys).
# Format starts with sk-or-v1-...
OPENROUTER_API_KEY=

# Optional: override the default model.
# Default: meta-llama/llama-3.3-70b-instruct:free
# Other free options: deepseek/deepseek-chat-v3-0324:free,
# google/gemini-2.0-flash-exp:free, qwen/qwen-2.5-72b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: branding for OpenRouter analytics/rankings.
OPENROUTER_REFERER=https://bikash-20.github.io
OPENROUTER_TITLE=Bikash Talukder | Portfolio

# Required for /api/weather: your OpenWeatherMap key (https://openweathermap.org/appid).
OPENWEATHER_API_KEY=

# Optional: city for the weather widget. Default: Dhaka
WEATHER_CITY=Dhaka
